string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef suffix)
set(root "${WORK_DIR}/mesh-voxelize-${suffix}/工程")
file(MAKE_DIRECTORY "${root}/assets")
file(COPY "${FIXTURES}/triangle.gltf" "${FIXTURES}/triangle.bin" "${FIXTURES}/rgba.png" DESTINATION "${root}/assets")
file(SHA256 "${root}/assets/triangle.gltf" original)
execute_process(COMMAND "${ASSETC}" voxelize --project-root "${root}" --source assets/triangle.gltf --output voxels --resolution 16
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error ENCODING UTF-8)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Voxel export failed: ${error}")
endif()
foreach(name project.json scene.json solid.dkvoxel grid.vdb conversion.json solid.dkvoxel.meta)
    if(NOT EXISTS "${root}/voxels/${name}")
        message(FATAL_ERROR "Missing bundle file ${name}")
    endif()
endforeach()
file(SHA256 "${root}/voxels/grid.vdb" before)
execute_process(COMMAND "${ASSETC}" voxelize --project-root "${root}" --source assets/triangle.gltf --output voxels --resolution 16
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(code EQUAL 0 OR NOT output STREQUAL "")
    message(FATAL_ERROR "Existing output was not refused")
endif()
file(SHA256 "${root}/voxels/grid.vdb" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "Failed overwrite changed the prior asset")
endif()
execute_process(COMMAND "${ASSETC}" voxelize --project-root "${root}" --source assets/triangle.gltf --output invalid --resolution 999
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(code EQUAL 0 OR EXISTS "${root}/invalid")
    message(FATAL_ERROR "Invalid resolution published output")
endif()
file(SHA256 "${root}/assets/triangle.gltf" after)
if(NOT original STREQUAL after)
    message(FATAL_ERROR "Voxel export changed source")
endif()
execute_process(COMMAND "${ASSETC}" cache --project-root "${root}/voxels" --source solid.dkvoxel
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "Published voxel asset did not reload: ${error}")
endif()
message(STATUS "Voxel bundle, Unicode path, reload and failure preservation passed")
