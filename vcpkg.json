{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "decker-engine",
  "version-semver": "0.1.0",
  "description": "DeckerEngine modular C++ engine",
  "builtin-baseline": "33d78c1ed898a06938f31312167c7abefd229455",
  "dependencies": [
    "stduuid"
  ],
  "default-features": [],
  "features": {
    "memory": {
      "description": "Multi-instance CPU heap resources",
      "dependencies": [{ "name": "mimalloc", "default-features": false }]
    },
    "profiling": {
      "description": "Optional Tracy CPU profiling client",
      "dependencies": [
        { "name": "tracy", "default-features": false, "features": ["on-demand"] }
      ]
    },
    "foundation": {
      "description": "Core logging and planned serialization dependencies",
      "dependencies": [
        "fmt",
        "spdlog",
        "nlohmann-json"
      ]
    },
    "math": {
      "description": "Eigen math foundation",
      "dependencies": [
        "eigen3"
      ]
    },
    "scene": {
      "description": "Scene ECS and project serialization",
      "dependencies": [
        "flecs",
        "nlohmann-json"
      ]
    },
    "commands": {
      "description": "Command values and schemas",
      "dependencies": ["nlohmann-json"]
    },
    "graphics": {
      "description": "Vulkan device, allocator and Slang compiler/runtime",
      "dependencies": [
        "vulkan",
        "vulkan-memory-allocator",
        "shader-slang"
      ]
    },
    "editor": {
      "description": "SDL3 and ImGui desktop editor backends",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "vulkan"
          ]
        },
        {
          "name": "imgui",
          "features": [
            "docking-experimental",
            "sdl3-binding",
            "vulkan-binding"
          ]
        }
      ]
    },
    "scripting": {
      "description": "Embedded Lua scripting",
      "dependencies": [
        "lua",
        "sol2"
      ]
    },
    "tests": {
      "description": "Catch2 unit test framework",
      "dependencies": [
        "catch2"
      ]
    }
  }
}
