* text=auto
*.cpp text eol=lf
*.hpp text eol=lf
*.slang text eol=lf
*.in text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
# Preserve upstream patch context markers (including a space-only context line).
cmake/vcpkg-ports/tracy/*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof
cmake/vcpkg-ports/mimalloc/*.diff text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.png binary
*.jpg binary
*.glb binary
*.spv binary
